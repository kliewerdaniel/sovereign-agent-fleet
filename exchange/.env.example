# Kalshi live credentials (OPT-IN, fail-closed).
#
# Copy this file to `exchange/.env` (gitignored) and fill in real values to
# enable KalshiLive. NEVER commit the real .env — it holds the private key.
#
# Even with creds present, route() will NOT place orders unless
# KalshiLive(allow_live_orders=True) is explicitly constructed. The running
# exchange API defaults to the STUB, so no live order fires by accident.
#
# KALSHI_API_KEY_ID=your-key-id
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# ...
# -----END RSA PRIVATE KEY-----"
#
# Optional: point at production instead of the risk-free demo sandbox.
# KALSHI_BASE_URL=https://api.kalshi.com/v1
